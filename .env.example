# ============================================================
# 需恋 · 环境变量样例
# 用法：复制成 .env 后按需修改。.env 已被 .gitignore 忽略，不会被提交。
#   cp .env.example .env
#
# ⚠️ 重要：本文件对同一类配置只出现一次，避免「后面的值覆盖前面的」导致配置失效。
#   本地开发用「基础 / 开发默认值」即可；要公网免費部署，请直接看文件最底部的
#   「FREE PUBLIC DEPLOY（Hugging Face Spaces）」段落，并改在平台 Secrets 里设置。
# ============================================================

# ===== AI（本地开发用 Ollama 自建开源模型，无需任何第三方 API Key）=====
# ⚠️ 以下 OLLAMA_* 仅本机开发使用（local dev only）。公网免費部署请改用底部「FREE PUBLIC DEPLOY」段落。
# Ollama 服务地址（仅后端访问，绝不下发前端、绝不可被用户覆盖）。本机默认 http://localhost:11434。
OLLAMA_BASE_URL=http://localhost:11434
# 主对话模型。需先 `ollama pull <模型名>` 拉取到本地，例如 qwen2.5:3b / llama3.2:3b / phi3:mini
OLLAMA_MODEL=qwen2.5:3b
# 轻量任务（情绪 / 记忆抽取 / JSON 结构化）模型，留空则用 OLLAMA_MODEL
OLLAMA_LIGHT_MODEL=
# 单次 AI 调用超时（毫秒）
AI_TIMEOUT_MS=120000

# ===== 服务（基础 / 开发默认值）=====
PORT=3000
# 监听地址：0.0.0.0 = 所有接口（可被局域网/公网访问）；纯本机调试设 127.0.0.1
HOST=0.0.0.0
# 生产环境部署请改为 production（部署到 HF 时由 FREE PUBLIC DEPLOY 段落 / Secrets 设为 production）
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# 是否在日志里打印用户消息全文（仅本地调试用，生产必须 0）
LOG_FULL_TEXT=0
# 网站正式地址（用于推送深链、日志提示）。开发填 http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# 允许跨域访问 API 的来源白名单（逗号分隔）。同源部署（后端直接托管前端）可留空。
# 绝不填 *（会泄露给任意网站并绕过认证）。
CORS_ORIGIN=

# ===== Web Push（VAPID）=====
# 用 `npm run push:keys` 自动生成并写入 .env，不用手填
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# _push 服务端联系邮箱，格式必须是 mailto:xxx@yyy.zzz
VAPID_MAILTO=mailto:your@email.com

# ===== 主动聊天 =====
# 是否启用主动聊天（0 = 关闭，开发期不想被打扰就设 0）
PROACTIVE_ENABLED=1
# Scheduler tick 间隔（毫秒），默认 10 分钟
PROACTIVE_TICK_MS=600000
# 调试路由（/api/proactive/tick 等），生产环境必须为 0
ENABLE_DEBUG_ROUTES=0

# ===== 其他 =====
# 默认时区（用于"今天"的判定：每日频控、活跃天）
APP_TZ=Asia/Taipei
# 自定义数据库路径（留空用 server/data/xulian.db）
XULIAN_DB_PATH=

# ============ 认证与会话 ============
# 会话 token 的 HMAC 签名密钥。生产环境必须换成随机长字串，泄露它等于可以伪造任何人的登录态。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# 是否允许「无 Bearer token」的匿名访问（X-User-Id 认人）：开发 1 / 生产 0
# 即使为 1，已注册的账号也绝不允许匿名访问。对外提供服务必须为 0。
ALLOW_ANONYMOUS=0

# ============================================================
# FREE PUBLIC DEPLOY（Hugging Face Spaces — 無需域名 / 伺服器，免費）
# 免費公網部署：用免費雲端 LLM（Groq / Gemini 等 OpenAI 兼容接口），無需本地 Ollama、無需域名/伺服器。
# 完整步骤见 DEPLOY.md「方案 A」。部署时请在 HF Space 的 Secrets / Variables 中设置以下变量
# （这些变量在运行时注入，会覆盖本文件上方任何同名的开发默认值）：
#   NODE_ENV=production
#   HOST=0.0.0.0
#   PORT=7860
#   CORS_ORIGIN=https://<your>.hf.space
#   CLIENT_ORIGIN=https://<your>.hf.space
#   SESSION_SECRET=<一段随机长字串>
#   ALLOW_ANONYMOUS=false
#   ENABLE_DEBUG_ROUTES=false
#   AI_PROVIDER=openai
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=<你的免費 Groq/Gemini Key>
#   OPENAI_MODEL=llama-3.3-70b-versatile
#   OPENAI_LIGHT_MODEL=llama-3.1-8b-instant
# （XULIAN_DB_PATH 預設 server/data/xulian.db；HF 免費盤為臨時盤，重啟會清空，持久化见 DEPLOY.md 的 Turso 方案）
# ============================================================
NODE_ENV=production
HOST=0.0.0.0
PORT=7860
CORS_ORIGIN=https://<your>.hf.space
CLIENT_ORIGIN=https://<your>.hf.space
SESSION_SECRET=<改成一段隨機長字串>
ALLOW_ANONYMOUS=false
ENABLE_DEBUG_ROUTES=false
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=<你的免費 Groq/Gemini Key>
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_LIGHT_MODEL=llama-3.1-8b-instant
